# ─── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string. Use a replica set / Atlas cluster — atomic
# transfers require a session-capable deployment.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/nexbank?retryWrites=true&w=majority

# JWT signing key — must be at least 32 characters of strong randomness.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_to_a_long_random_value_at_least_32_characters

# Card data encryption key — 32 raw bytes encoded as 64 hex chars.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARD_ENC_KEY=change_me_to_64_hex_chars_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Comma-separated list of allowed origins. Only these domains may call the API
# from a browser. Localhost is auto-allowed in non-production.
CORS_ORIGINS=https://nexbank.example.com

# ─── Optional ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
